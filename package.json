{
  "name": "trekit-live-place-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 0.0.0.0 --config client/vite.config.js",
    "dev:server": "node --watch server/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.js",
    "build:server": "node --check server/index.js",
    "start": "node server/index.js",
    "test": "node --test server/test/**/*.test.js"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "express": "^5.1.0",
    "pngjs": "^7.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
